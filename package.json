{
  "name": "decorstore",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @decorstore/web dev",
    "build": "pnpm --filter @decorstore/web build",
    "type-check": "pnpm -r --if-present run type-check",
    "lint": "pnpm --filter @decorstore/web lint"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  }
}
