# Media (Cloudinary)
# Cloudinary Cloud Name
CLOUDINARY_CLOUD_NAME=""
# Cloudinary API Key
CLOUDINARY_API_KEY=""
# Cloudinary API Secret
CLOUDINARY_API_SECRET=""

# Search (Typesense)
# Typesense Host (localhost or cloud)
